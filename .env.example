# Copy to .env. NEVER commit .env
OPENROUTER_API_KEY=
# Models are tried in order; free ones are often rate-limited, so list several. Add a paid one first (e.g. google/gemini-2.5-flash) when you have credit.
LLM_MODELS=baidu/ernie-5.5-flash-preview:free,openrouter/free,google/gemma-4-31b-it:free,inclusionai/ling-3.2-flash:free
PORT=3000
