# Copy to .env. NEVER commit .env
# Any ONE of these keys is enough; add several for more free quota (each provider has its own limits).
GEMINI_API_KEY=            # aistudio.google.com/apikey (free tier)
GROQ_API_KEY=              # console.groq.com (free tier)
OPENROUTER_API_KEY=        # openrouter.ai (free models ":free", about 50 requests/day until you add credits)
# Models are tried in order; "provider:model" (gemini, groq, cerebras, mistral, openrouter). No prefix = OpenRouter model.
LLM_MODELS=gemini:gemini-flash-lite-latest,gemini:gemini-3.5-flash-lite,groq:llama-3.3-70b-versatile,baidu/ernie-5.5-flash-preview:free,openrouter/free
PORT=3000
